# --- Database ---
DATABASE_URL=postgresql+psycopg://corvin:corvin@db:5432/corvin

# --- Auth ---
JWT_SECRET_KEY=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Webhook ---
WEBHOOK_TOKEN=change-me-webhook-shared-secret
WEBHOOK_RATE_LIMIT_PER_MINUTE=30

# --- Data residency / LLM ---
# Corvin refuses to send incident data to a non-EU-hosted LLM provider unless
# this is explicitly set to true. Flipping it on is a deliberate compliance
# decision, not a default.
ALLOW_NON_EU_LLM=false
LLM_PROVIDER_REGION=non-eu
# Leave empty to draft from the deterministic templates only (fully supported).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Deployment ---
# With APP_ENV=production the app refuses to start on the placeholder secrets above.
APP_ENV=development
DEFAULT_TIMEZONE=Europe/Brussels
HOSTING_REGION=EU
